# ====================================================================
# PashuX AI Configuration - Supabase & CCTV Credentials
# Copy this file to .env and fill in your actual values.
# ====================================================================

# Supabase Project Credentials (from your Supabase Dashboard -> Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Anon / Public Key (or Service Role Key for backend processing)
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service Role Key (kept strictly on server/backend for bypass admin uploads)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Farm & Camera Configuration
FARM_ID=11111111-1111-1111-1111-111111111111
CAMERA_ID=CAM01

# Storage Buckets (must match supabase_schema.sql)
STORAGE_BUCKET_IMAGES=pashux-activity-images
STORAGE_BUCKET_VIDEOS=pashux-activity-videos

# Activity Capture Settings
VIDEO_CLIP_DURATION_SEC=10
PRE_EVENT_BUFFER_SEC=4
POST_EVENT_BUFFER_SEC=6
ACTIVITY_COOLDOWN_SEC=60

# JWT Auth Secret for Local Session Tokens
JWT_SECRET=pashux-super-secret-key-2026-cattle-ai

# Server Port for Web Dashboard & Activity History UI
WEB_DASHBOARD_PORT=8000
