[Unit]
Description=PashuX AI Cattle Detection & Video Management Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Cattle-data-collection
EnvironmentFile=/home/ubuntu/Cattle-data-collection/.env
ExecStart=/home/ubuntu/Cattle-data-collection/venv/bin/uvicorn pashux_web_dashboard:app --host 0.0.0.0 --port 8000 --workers 1
Restart=always
RestartSec=5
StandardOutput=append:/var/log/pashux_stdout.log
StandardError=append:/var/log/pashux_stderr.log
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
